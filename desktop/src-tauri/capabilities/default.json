{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Panda main window: process commands, external links, notifications and notification window activation.",
  "windows": ["main"],
  "permissions": [
    "core:default", "opener:default",
    "core:window:allow-is-focused", "core:window:allow-show",
    "core:window:allow-unminimize", "core:window:allow-set-focus",
    "notification:allow-notify", "notification:allow-is-permission-granted",
    "notification:allow-request-permission", "notification:allow-register-listener",
    "notification:allow-remove-listener"
  ]
}
