{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panda",
  "version": "0.2.0",
  "identifier": "com.lukaisluka.panda",
  "build": {
    "beforeDevCommand": "pnpm --dir .. dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir .. build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Panda",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGMUEwNUU5QUYyNzM3MkIKUldRck55ZXY2UVVhYnhrMCtMRktIRzQ1VndqWjdmU2t5a2hHY2JZN2VidmVtOEhFTHh1NnltaGwK",
      "endpoints": [
        "https://git.davidhoeppner.ca/la-creche/Panda/releases/download/latest/latest.json"
      ]
    }
  }
}
